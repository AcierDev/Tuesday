# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node modules (no trailing slash: also ignores a node_modules symlink)
node_modules

# iCloud: *.nosync folders are excluded from sync (node_modules/.next can point here)
*.nosync

# Finder/iCloud duplicate copies ("file 2.tsx", "folder 3")
* [0-9].*
* [0-9]

# Build directories
dist/
build/
out/

# Dependency directories
jspm_packages/
.pnp/
.pnp.js

# Typescript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Testing
coverage/
*.lcov

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# MacOS
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Package manager files (package-lock.json is committed for reproducible installs)
yarn.lock
.pnpm-lock.yaml

# Parcel-bundler cache (if used)
.cache/
.parcel-cache/

# SvelteKit build artifacts (if used)
.svelte-kit/
.svelte/

# Next.js (no trailing slash: also ignores a .next symlink)
.next
.next-backup-*/
*.next

# Nuxt.js
.nuxt/
.nuxt

# Remix
.build/

# Vue.js
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Temporary files and directories
tmp/
temp/

# System files
Thumbs.db

app/testing/page.css

# Data directory
/data
.vercel
